{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "clang",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "clang",
      "configuration": "Release"
    }
  ]
}