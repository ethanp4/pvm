{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build pvm (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\build",
                "--config",
                "Debug",
                "--target",
                "pvm"
